+requireNode();
+const evidence = path.join(ROOT, 'evidence', 'm1b');
+await mkdir(evidence, { recursive: true });
+const npmCli = path.join(path.dirname(process.execPath), 'node_modules', 'npm', 'bin', 'npm-cli.js');
